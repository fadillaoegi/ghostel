{
  "name": "ghostel",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "dev": "pnpm --parallel --filter @ghostel/server --filter @ghostel/web dev",
    "dev:lan": "node scripts/dev-lan.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tsconfig.json",
    "test": "pnpm --filter @ghostel/shared test && pnpm --filter @ghostel/web test && pnpm --filter @ghostel/server test",
    "test:unit": "pnpm --filter @ghostel/shared test && pnpm --filter @ghostel/web test",
    "test:server": "pnpm --filter @ghostel/server test",
    "test:e2e": "pnpm build && playwright test",
    "build": "pnpm --filter @ghostel/web build && pnpm --filter @ghostel/server build",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.js",
    "test:prod": "pnpm build && playwright test -c playwright.prod.config.ts",
    "test:hooks": "node --test \"scripts/kiro-hooks/test/*.test.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  }
}
