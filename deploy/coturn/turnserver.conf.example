# coturn for Ghostel calls (M22). Copy to turnserver.conf on the VPS and fill in the three CHANGE_ME values.
# Ghostel's server hands out short-lived credentials signed with the same secret (TURN_SECRET in .env).

listening-port=3478
# TLS on 5349 (turns:) helps on networks that only allow HTTPS-like traffic. Needs a certificate, see docs/DEPLOY.md.
# tls-listening-port=5349
# cert=/etc/coturn/certs/fullchain.pem
# pkey=/etc/coturn/certs/privkey.pem

fingerprint
use-auth-secret
# Same value as TURN_SECRET in Ghostel's .env (openssl rand -hex 32).
static-auth-secret=CHANGE_ME_SAME_AS_TURN_SECRET
realm=CHANGE_ME_turn.example.com

# The VPS's public IP. Needed when the VPS has a private address behind 1:1 NAT (many cloud providers).
# external-ip=CHANGE_ME_PUBLIC_IP

# Relay ports: open these as UDP in the firewall too.
min-port=49160
max-port=49200

# Limits: a call with camera is about 1–2 Mbit/s per person.
user-quota=12
total-quota=120
max-bps=3000000
stale-nonce=600

# Never relay to private, loopback, CGNAT or link-local addresses, so the relay cannot reach the VPS's own
# services (PostgreSQL, the Ghostel server on 127.0.0.1) or the provider's internal network.
no-multicast-peers
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=100.64.0.0-100.127.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.0.0.0-192.0.0.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=198.18.0.0-198.19.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff

no-cli
log-file=stdout
simple-log
