{
  "name": "@ghostel/video",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Intro and outro of the Ghostel demo video (Remotion). Not part of the app build.",
  "scripts": {
    "audio": "tsx scripts/make-audio.ts",
    "studio": "pnpm audio && remotion studio",
    "render:intro": "remotion render src/index.ts Intro ../ghostel-intro.mp4 --gl=angle --crf=18",
    "render:outro": "remotion render src/index.ts Outro ../ghostel-outro.mp4 --gl=angle --crf=18",
    "render": "pnpm audio && pnpm render:intro && pnpm render:outro",
    "still": "remotion still src/index.ts --gl=angle",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource/creepster": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@react-three/fiber": "9.8.2",
    "@remotion/cli": "4.0.543",
    "@remotion/three": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "tsx": "4.23.15"
  }
}
