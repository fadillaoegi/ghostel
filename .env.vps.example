# Settings for compose.vps.yaml. Copy to .env.vps, fill in, then chmod 600 .env.vps. Never commit .env.vps.

# Password of the "ghostel" role on the shared PostgreSQL server (127.0.0.1:8100).
POSTGRES_PASSWORD=CHANGE_ME

# The exact public HTTPS address (the Cloudflare Tunnel hostname), without a trailing slash.
ALLOWED_ORIGINS=https://ghostel.example.com

# Optional STUN/TURN servers for voice and video (JSON array of RTCIceServer). Empty = one public STUN server.
VOICE_ICE_SERVERS=
