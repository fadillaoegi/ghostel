# Ghostel production settings (own VPS behind a reverse proxy such as Caddy).
# On the server: copy this file to `.env` next to package.json, fill in the values, then
#   chmod 600 .env
# `pnpm start` reads `.env` (node --env-file-if-exists=.env). Never commit the filled-in file.

NODE_ENV=production

# The Node server listens only on the VPS itself; the reverse proxy (HTTPS on 443) forwards to it.
# Use 0.0.0.0 only if the server runs in its own container and the proxy reaches it over a private network.
HOST=127.0.0.1
PORT=2590

# PostgreSQL 18. Generate the password with:  openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# The database must not be reachable from the internet (bind it to 127.0.0.1 or a private Docker network).
POSTGRES_USER=ghostel
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ghostel
DATABASE_URL=postgres://ghostel:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@127.0.0.1:5432/ghostel

# The exact public HTTPS address of the app, without a trailing slash. Several are allowed, comma-separated
# (for example the domain with and without www). The server refuses http:// origins in production,
# except http://localhost for the local smoke test.
ALLOWED_ORIGINS=https://ghostel.example.com

# How many reverse proxies sit in front of the server: 1 for Caddy or nginx on the same VPS.
# Never more than there really are: clients could fake their IP to dodge rate limits.
TRUST_PROXY=1

# STUN/TURN servers for voice and video (JSON array of RTCIceServer). Empty = one public Google STUN server.
# Add a TURN server if calls fail between some networks, for example coturn on the same VPS:
# VOICE_ICE_SERVERS=[{"urls":"stun:ghostel.example.com:3478"},{"urls":"turn:ghostel.example.com:3478","username":"ghostel","credential":"CHANGE_ME"}]
VOICE_ICE_SERVERS=

# Optional: where the built web app is (default apps/web/dist).
# WEB_DIST=/srv/ghostel/apps/web/dist

# Do NOT set TRIVIA_FAST in production (it is for automated tests; the server refuses it in production).
