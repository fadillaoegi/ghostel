# Local development values. Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=2590

# PostgreSQL from docker-compose.yml (local-only credentials)
POSTGRES_USER=ghostel
POSTGRES_PASSWORD=ghostel_local_only
POSTGRES_DB=ghostel
DATABASE_URL=postgres://ghostel:ghostel_local_only@127.0.0.1:5490/ghostel
TEST_DATABASE_URL=postgres://ghostel:ghostel_local_only@127.0.0.1:5490/ghostel_test

# Comma-separated list of origins allowed to call mutating APIs and open WebSockets
ALLOWED_ORIGINS=http://localhost:5290,http://127.0.0.1:5290,http://localhost:2590,http://127.0.0.1:2590

# STUN/TURN servers for voice (JSON array of RTCIceServer). Empty = one public Google STUN server.
# Example with TURN: [{"urls":"turn:turn.example.com:3478","username":"ghostel","credential":"change-me"}]
VOICE_ICE_SERVERS=

# Number of reverse-proxy hops to trust for the client IP (rate limiting). 0 locally, 1 on Render.
TRUST_PROXY=0
