# Local development values. Copy to .env and adjust. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=8108

# PostgreSQL 18 on 127.0.0.1:8100 (shared server, own role "ghostel" and databases ghostel + ghostel_test).
# Put the real password in .env; the POSTGRES_* lines are only used by the optional docker-compose.yml.
POSTGRES_USER=ghostel
POSTGRES_PASSWORD=ghostel_local_only
POSTGRES_DB=ghostel
DATABASE_URL=postgres://ghostel:ghostel_local_only@127.0.0.1:8100/ghostel
TEST_DATABASE_URL=postgres://ghostel:ghostel_local_only@127.0.0.1:8100/ghostel_test

# Comma-separated list of origins allowed to call mutating APIs and open WebSockets
ALLOWED_ORIGINS=http://localhost:8109,http://127.0.0.1:8109,http://localhost:8108,http://127.0.0.1:8108

# STUN/TURN servers for voice (JSON array of RTCIceServer). Empty = one public Google STUN server.
# Example with TURN: [{"urls":"turn:turn.example.com:3478","username":"ghostel","credential":"change-me"}]
VOICE_ICE_SERVERS=

# Number of reverse-proxy hops to trust for the client IP (rate limiting). 0 locally, 1 on Render.
TRUST_PROXY=0
